// RUN: sym-opt --allow-unregistered-dialect --test-reloc-utils --verify-diagnostics %s | FileCheck %s

// Wire format v1 goldens (C3, issue #143; docs/reloc-plan-format.md "Wire
// Format v1"). The hex lines are the committed golden blobs: any encoder
// change that alters the byte stream fails FileCheck, and
// libreloc/test/TypedDecodeTest.cpp decodes these exact bytes. The v0
// goldens in serialize.mlir are untouched by the typed encoder.

// Per-channel quantize on axis 1 of [B, 3], then transpose: a runtime scale
// binding over [3], a channel map with a plan symbol (d0 mod B), symbol
// table [B] in first-use order (source descriptor first).
// CHECK: typed_plan_hex(quantize_transpose): 
// expected-remark @below {{encoded typed 455 bytes, deterministic = true, symbols = [B]}}
"test.plan"() {serialize, name = "quantize_transpose", typed_plan = #reloc.typed_plan<source = tensor<[B, 3], f32>, result = tensor<[3, B], i8>, symbols = ["B"], layout = #reloc.plan<src = tensor<[B, 3], f32>, dst = tensor<[3, B], i8>, perm = [1, 0], axes = [{name = "d0", extent = 3, src_stride = 1, dst_stride = B}, {name = "d1", extent = B, src_stride = 3, dst_stride = 1}], constraints = {contiguous = [true, false], no_copy = false}, inverse = affine_map<(d0, d1) -> (d1, d0)>>, stages = [#reloc.stage<quantize symmetric_rne : f32 -> i8, shape = [B, 3], scale = #reloc.binding<"s" : [3], f32>, axis = 1, channel = (d0, d1)[s0] -> (d0 mod s0)>]>} : () -> ()

// The order witness: pad f32 1.0 then quantize at scale 0.5; the layout
// carries the fused code 2, the fill entry the original 1.0 at stage 0.
// CHECK: typed_plan_hex(pad_quantize): 
// expected-remark @below {{encoded typed 393 bytes, deterministic = true, symbols = []}}
"test.plan"() {serialize, name = "pad_quantize", typed_plan = #reloc.typed_plan<source = tensor<[6], f32>, result = tensor<[8], i8>, layout = #reloc.plan<src = tensor<[6], f32>, dst = tensor<[8], i8>, perm = [0], axes = [{name = "d0", extent = 6, src_stride = 1, dst_stride = 1}], pad_fill = [{dst_axis = 0, lo = 1, hi = 1, value = 2 : i8}], constraints = {contiguous = [true], no_copy = false}, inverse = affine_map<(d0) -> (d0)>>, stages = [#reloc.stage<quantize symmetric_rne : f32 -> i8, shape = [8], scale = dense<5.000000e-01> : tensor<f32>>], fills = [{dst_axis = 0, stage = 0, value = 1.000000e+00 : f32}]>} : () -> ()

// The C3 footprint witness: symbolic N, f32 -> s8 -> f32 with inline
// per-tensor scales, no pads. Binding N = 192 gives source 768, boundary 1
// (the s8 tensor) 192, destination 768 bytes (TypedBindTest).
// CHECK: typed_plan_hex(quant_dequant_sym): 
// expected-remark @below {{encoded typed 366 bytes, deterministic = true, symbols = [N]}}
"test.plan"() {serialize, name = "quant_dequant_sym", typed_plan = #reloc.typed_plan<source = tensor<[N], f32>, result = tensor<[N], f32>, layout = #reloc.plan<src = tensor<[N], f32>, dst = tensor<[N], f32>, perm = [0], axes = [{name = "d0", extent = N, src_stride = 1, dst_stride = 1}], constraints = {contiguous = [true], no_copy = false}, inverse = affine_map<(d0) -> (d0)>>, stages = [#reloc.stage<quantize symmetric_rne : f32 -> i8, shape = [N], scale = dense<5.000000e-01> : tensor<f32>>, #reloc.stage<dequantize affine : i8 -> f32, shape = [N], scale = dense<5.000000e-01> : tensor<f32>>]>} : () -> ()

// A symbolic channel extent: per-channel quantize on axis 0 of [B, 3] with
// a runtime scale declared over [B]; rebinding B must re-validate the
// parameter length (TypedBindTest).
// CHECK: typed_plan_hex(quantize_channel_sym): 
// expected-remark @below {{encoded typed 449 bytes, deterministic = true, symbols = [B]}}
"test.plan"() {serialize, name = "quantize_channel_sym", typed_plan = #reloc.typed_plan<source = tensor<[B, 3], f32>, result = tensor<[B, 3], i8>, layout = #reloc.plan<src = tensor<[B, 3], f32>, dst = tensor<[B, 3], i8>, perm = [0, 1], axes = [{name = "d0", extent = B, src_stride = 3, dst_stride = 3}, {name = "d1", extent = 3, src_stride = 1, dst_stride = 1}], constraints = {contiguous = [false, true], no_copy = false}, inverse = affine_map<(d0, d1) -> (d0, d1)>>, stages = [#reloc.stage<quantize symmetric_rne : f32 -> i8, shape = [B, 3], scale = #reloc.binding<"s" : [B], f32>, axis = 0, channel = (d0, d1) -> (d0)>]>} : () -> ()

// Runtime scale AND zero point on a dequantize (both per tensor).
// CHECK: typed_plan_hex(dequant_binding): 
// expected-remark @below {{encoded typed 315 bytes, deterministic = true, symbols = [N]}}
"test.plan"() {serialize, name = "dequant_binding", typed_plan = #reloc.typed_plan<source = tensor<[N], i8>, result = tensor<[N], f32>, layout = #reloc.plan<src = tensor<[N], i8>, dst = tensor<[N], f32>, perm = [0], axes = [{name = "d0", extent = N, src_stride = 1, dst_stride = 1}], constraints = {contiguous = [true], no_copy = false}, inverse = affine_map<(d0) -> (d0)>>, stages = [#reloc.stage<dequantize affine : i8 -> f32, shape = [N], scale = #reloc.binding<"s" : [], f32>, zero_point = #reloc.binding<"zp" : [], i32>>]>} : () -> ()

// Two stages with an inline zero point and a narrowing cast: dequantize
// s8 -> f32 (scale 0.25, zero point -3), then f32 -> f16.
// CHECK: typed_plan_hex(dequant_cast): 
// expected-remark @below {{encoded typed 389 bytes, deterministic = true, symbols = []}}
"test.plan"() {serialize, name = "dequant_cast", typed_plan = #reloc.typed_plan<source = tensor<[4], i8>, result = tensor<[4], f16>, layout = #reloc.plan<src = tensor<[4], i8>, dst = tensor<[4], f16>, perm = [0], axes = [{name = "d0", extent = 4, src_stride = 1, dst_stride = 1}], constraints = {contiguous = [true], no_copy = false}, inverse = affine_map<(d0) -> (d0)>>, stages = [#reloc.stage<dequantize affine : i8 -> f32, shape = [4], scale = dense<2.500000e-01> : tensor<f32>, zero_point = dense<-3> : tensor<i32>>, #reloc.stage<cast ieee_rne : f32 -> f16, shape = [4]>]>} : () -> ()

// R3: cast f32 -> f16 then pad with an f16 fill: the pad enters at
// boundary 1, so no transfer cut before the cast has a padded layout.
// CHECK: typed_plan_hex(cast_pad): 
// expected-remark @below {{encoded typed 375 bytes, deterministic = true, symbols = []}}
"test.plan"() {serialize, name = "cast_pad", typed_plan = #reloc.typed_plan<source = tensor<[6], f32>, result = tensor<[8], f16>, layout = #reloc.plan<src = tensor<[6], f32>, dst = tensor<[8], f16>, perm = [0], axes = [{name = "d0", extent = 6, src_stride = 1, dst_stride = 1}], pad_fill = [{dst_axis = 0, lo = 1, hi = 1, value = 1.000000e+00 : f16}], constraints = {contiguous = [true], no_copy = false}, inverse = affine_map<(d0) -> (d0)>>, stages = [#reloc.stage<cast ieee_rne : f32 -> f16, shape = [6]>], fills = [{dst_axis = 0, stage = 1, value = 1.000000e+00 : f16}]>} : () -> ()

// R3: the other pad order: quantize at scale 0.5, then pad the s8 result
// with code 1 (pad_quantize above pads f32 1.0 first and carries code 2).
// CHECK: typed_plan_hex(quantize_pad): 
// expected-remark @below {{encoded typed 393 bytes, deterministic = true, symbols = []}}
"test.plan"() {serialize, name = "quantize_pad", typed_plan = #reloc.typed_plan<source = tensor<[6], f32>, result = tensor<[8], i8>, layout = #reloc.plan<src = tensor<[6], f32>, dst = tensor<[8], i8>, perm = [0], axes = [{name = "d0", extent = 6, src_stride = 1, dst_stride = 1}], pad_fill = [{dst_axis = 0, lo = 1, hi = 1, value = 1 : i8}], constraints = {contiguous = [true], no_copy = false}, inverse = affine_map<(d0) -> (d0)>>, stages = [#reloc.stage<quantize symmetric_rne : f32 -> i8, shape = [6], scale = dense<5.000000e-01> : tensor<f32>>], fills = [{dst_axis = 0, stage = 1, value = 1 : i8}]>} : () -> ()

// R3: the exact widening cast on its own.
// CHECK: typed_plan_hex(cast_widen): 
// expected-remark @below {{encoded typed 311 bytes, deterministic = true, symbols = []}}
"test.plan"() {serialize, name = "cast_widen", typed_plan = #reloc.typed_plan<source = tensor<[4], f16>, result = tensor<[4], f32>, layout = #reloc.plan<src = tensor<[4], f16>, dst = tensor<[4], f32>, perm = [0], axes = [{name = "d0", extent = 4, src_stride = 1, dst_stride = 1}], constraints = {contiguous = [true], no_copy = false}, inverse = affine_map<(d0) -> (d0)>>, stages = [#reloc.stage<cast exact : f16 -> f32, shape = [4]>]>} : () -> ()

// R3: the C1 channel witness ([2, 3, 4], axis 1, scales [0.5, 1, 2]) with
// the channel axis moved to result axis 0 by a transpose.
// CHECK: typed_plan_hex(witness_channel_transpose): 
// expected-remark @below {{encoded typed 606 bytes, deterministic = true, symbols = []}}
"test.plan"() {serialize, name = "witness_channel_transpose", typed_plan = #reloc.typed_plan<source = tensor<[2, 3, 4], f32>, result = tensor<[3, 2, 4], i8>, layout = #reloc.plan<src = tensor<[2, 3, 4], f32>, dst = tensor<[3, 2, 4], i8>, perm = [1, 0, 2], axes = [{name = "d0", extent = 3, src_stride = 4, dst_stride = 8}, {name = "d1", extent = 2, src_stride = 12, dst_stride = 4}, {name = "d2", extent = 4, src_stride = 1, dst_stride = 1}], constraints = {contiguous = [false, false, true], no_copy = false}, inverse = affine_map<(d0, d1, d2) -> (d1, d0, d2)>>, stages = [#reloc.stage<quantize symmetric_rne : f32 -> i8, shape = [2, 3, 4], scale = dense<[5.000000e-01, 1.000000e+00, 2.000000e+00]> : tensor<3xf32>, axis = 1, channel = (d0, d1, d2) -> (d0)>]>} : () -> ()
