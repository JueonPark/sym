@LIT_SITE_CFG_IN_HEADER@

import os

# Make paths relocatable - use relative paths from this file's location
_this_dir = os.path.dirname(os.path.realpath(__file__))
_build_dir = os.path.dirname(_this_dir)  # build/sym
_source_dir = os.path.dirname(os.path.dirname(_build_dir))  # workspace root

config.llvm_tools_dir = os.environ.get("LLVM_TOOLS_DIR", "@LLVM_TOOLS_BINARY_DIR@")
config.sym_source_dir = _source_dir
config.sym_build_dir = _build_dir

import lit.llvm
lit.llvm.initialize(lit_config, config)

lit_config.load_config(config, os.path.join(_source_dir, "test/lit.cfg.py"))
